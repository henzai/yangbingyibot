{
	"name": "yangbingyibot",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --minify src/index.ts",
		"dev": "wrangler dev src/index.ts",
		"eval:llm": "node --import tsx tools/llm-eval/cli.ts",
		"eval:llm:report": "node --import tsx tools/llm-eval/report-cli.ts",
		"start": "wrangler dev",
		"test": "vitest run && vitest run --config vitest.eval.config.mts",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types",
		"register": "node scripts/register.js",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eval.json",
		"verify": "npm run check:ci && npm run typecheck && npm test && wrangler deploy --dry-run --minify src/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@cloudflare/vitest-pool-workers": "^0.21.0",
		"@types/node": "^24.13.0",
		"dotenv": "^17.0.0",
		"tsx": "^4.23.13",
		"typescript": "^7.0.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@google/genai": "^2.0.0",
		"cloudflare-workers-and-google-oauth": "^2.0.0",
		"discord-api-types": "^0.38.0",
		"discord-interactions": "^4.0.0",
		"google-spreadsheet": "^5.0.0",
		"hono": "^4.3.11",
		"openai": "^7.10.0"
	}
}
