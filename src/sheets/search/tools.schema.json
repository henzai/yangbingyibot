									"type": "string",
									"minLength": 1,
									"maxLength": 10
								},
								{
									"type": "null"
								}
							]
						},
						"target_age": {
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0,
									"maximum": 120
								},
								{
									"type": "null"
								}
							]
						}
					},
