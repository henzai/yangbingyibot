	{
		"type": "function",
		"name": "aggregate_records",
		"description": "Calculate bounded typed metrics on the same exact condition set. count uses distinct record IDs; grouped counts may overlap. Preserve ties and missing-value denominators. difference is left minus right; best_rank uses positive year-labeled ranks only.",
		"strict": true,
		"parameters": {
			"type": "object",
			"properties": {
				"dataset": {
					"$ref": "#/$defs/dataset"
				},
				"where": {
					"anyOf": [
						{
							"$ref": "#/$defs/where"
						},
