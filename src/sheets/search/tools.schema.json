[
	{
		"type": "function",
		"name": "search_records",
		"description": "Find identity candidates or literal text matches in an allowed dataset. Candidates and lexical matches do not prove concept recall or a complete answer set. Ambiguity and source availability must remain explicit.",
		"strict": true,
		"parameters": {
			"type": "object",
			"properties": {
				"dataset": {
					"$ref": "#/$defs/dataset"
				},
				"query": {
					"type": "string",
					"minLength": 1,
					"maxLength": 512
				},
				"mode": {
					"type": "string",
					"enum": ["identity", "text"]
				},
				"search_fields": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/field"
							},
							"minItems": 1,
							"maxItems": 20
						},
						{
							"type": "null"
						}
					]
				},
				"where": {
					"anyOf": [
						{
							"$ref": "#/$defs/where"
						},
						{
							"type": "null"
						}
					]
				},
				"page_size": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100
				},
				"cursor": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 2048
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"dataset",
				"query",
				"mode",
				"search_fields",
				"where",
				"page_size",
				"cursor"
			],
			"additionalProperties": false,
			"$defs": {
				"atom": {
					"type": "object",
					"properties": {
						"field": {
							"$ref": "#/$defs/field"
						},
						"op": {
							"type": "string",
							"enum": [
								"eq",
								"in",
								"lt",
								"lte",
								"gt",
								"gte",
								"contains",
								"starts_with",
								"not_in",
								"is_missing",
								"is_present"
							]
						},
						"values": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/scalar"
							},
							"minItems": 0,
							"maxItems": 50
						}
					},
					"required": ["field", "op", "values"],
					"additionalProperties": false
				},
				"branch": {
					"type": "object",
					"properties": {
						"all": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/atom"
							},
							"minItems": 1,
							"maxItems": 8
						}
					},
					"required": ["all"],
					"additionalProperties": false
				},
				"dataset": {
					"type": "string",
					"enum": ["members", "reference"]
				},
				"field": {
					"type": "string",
					"enum": [
						"status",
						"primary_affiliation",
						"secondary_affiliation",
						"newcomer_flag",
						"latest_rank",
						"full_name",
						"pinyin",
						"age",
						"initials",
						"community_nicknames",
						"nickname_origin",
						"birthday",
						"debut_date",
						"generation",
						"height",
						"zodiac",
						"birth_province",
						"birth_city",
						"skills",
						"hobbies",
						"catchphrase",
						"official_nickname",
						"official_english_name",
						"university",
						"blood_type",
						"mbti",
						"debut_age",
						"pocket_followers",
						"support_color_1",
						"support_color_1_detail",
						"support_color_2",
						"support_color_2_detail",
						"election_2014",
						"election_2015",
						"election_2016",
						"election_2017",
						"election_2018",
						"election_2019",
						"election_2020",
						"election_2021",
						"election_2022",
						"election_2023",
						"election_2024",
						"election_2025",
						"election_2026",
						"career",
						"member_id",
						"generation_group",
						"generation_number",
						"current_group",
						"current_team",
						"state_flags",
						"election_history",
						"age_at",
						"tenure_completed_years",
						"tenure_ordinal_year",
						"days_until_birthday",
						"days_until_target_age",
						"reference_title",
						"reference_body"
					]
				},
				"scalar": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 512
						},
						{
							"type": "number"
						},
						{
							"type": "boolean"
						}
					]
				},
				"where": {
					"type": "object",
					"properties": {
						"any": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/branch"
							},
							"minItems": 1,
							"maxItems": 8
						}
					},
					"required": ["any"],
					"additionalProperties": false
				}
			}
		}
