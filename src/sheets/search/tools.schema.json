							"type": "null"
						}
					]
				},
				"metrics": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"op": {
								"type": "string",
								"enum": [
									"count",
									"min",
									"max",
									"mean",
									"best_rank",
									"difference"
								]
							},
							"field": {
								"anyOf": [
									{
										"$ref": "#/$defs/field"
									},
									{
										"type": "null"
									}
								]
							},
							"operands": {
								"anyOf": [
									{
										"type": "object",
										"properties": {
											"left_id": {
												"type": "string",
												"minLength": 1,
												"maxLength": 160
											},
											"right_id": {
												"type": "string",
												"minLength": 1,
												"maxLength": 160
											}
										},
										"required": ["left_id", "right_id"],
										"additionalProperties": false
									},
									{
										"type": "null"
									}
								]
							}
						},
						"required": ["op", "field", "operands"],
						"additionalProperties": false
					},
					"minItems": 1,
					"maxItems": 5
				},
				"group_by": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/field"
					},
					"minItems": 0,
					"maxItems": 3
