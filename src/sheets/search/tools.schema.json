									"type": "null"
								}
							]
						}
					},
					"required": ["as_of", "target_age"],
					"additionalProperties": false
				},
				"cursor": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 2048
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
